# ──────────────────────────────────────────────────────────────
# TurneyApp environment configuration (copy to .env, never commit)
# ──────────────────────────────────────────────────────────────

# ── Supabase (client + server) ────────────────────────────────
# Find these in your Supabase project: Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-only (Edge Functions / never ship to the Flutter client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── InterActive QRIS OPEN API (qris.id) ───────────────────────
# Obtain after registering a legal entity at
# https://qris.interactive.co.id/homepage/open-api.php
# Leave QRIS_MOCK=true until you have live credentials.
QRIS_MOCK=true
QRIS_BASE_URL=https://qris.interactive.co.id/restapi/qris/show_qris.php
QRIS_API_KEY=
QRIS_MERCHANT_ID=
QRIS_STORE_ID=
# Shared secret used to verify the payment callback from qris.id
QRIS_CALLBACK_SECRET=

# ── Platform economics ────────────────────────────────────────
# Platform commission taken from every paid registration (0.10 = 10%)
PLATFORM_FEE_RATE=0.10

# ── Transactional email (dispute notifications, receipts) ──────
# Resend (https://resend.com) — or swap for SMTP in send-email function
RESEND_API_KEY=
EMAIL_FROM="TurneyApp <no-reply@turneyapp.example>"

# ── Match auto-resolve window (minutes) ───────────────────────
MATCH_AUTO_RESOLVE_MINUTES=5
